# Variables de entorno (12-Factor III: Config). Copiar como .env y ajustar:
#     cp .env.example .env
# Todas son opcionales: sin .env rigen los valores por defecto.

EXTRACTOR_PORT=8080          # puerto del host; el que usan los scripts del profesor
EXTRACTOR_REPLICAS=5         # el TP permite hasta 5
QUEUE_TIMEOUT_S=20           # espera máxima por un lugar antes de responder 503
REQUEST_TIMEOUT_S=25         # presupuesto total; menor al timeout de cliente (30 s)
